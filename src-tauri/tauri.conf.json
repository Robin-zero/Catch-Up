{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "追更 CatchUp",
  "version": "1.1.0",
  "identifier": "tech.rmiao.apps.catchup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "追更 · CatchUp",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Robin-zero/Catch-Up/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RDNCMjU4NkUxMzI2OTAKUldTUUpoTnVXTExUaFd6KzcweEtRcnd1RWRaNWw1NnhwTFVlOVFpNTBnNDRDWDB3WXBqTmNLZ00K",
      "dialog": false
    }
  }
}
